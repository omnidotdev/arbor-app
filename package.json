{
  "name": "@omnidotdev/arbor-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "concurrently --kill-others --names \"GRAPHQL-CODEGEN,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"bun run graphql:generate:watch\" \"bun dev:vite\"",
    "dev:vite": "bun --env-file .env.local --env-file .env.development vite dev",
    "graphql:generate": "NODE_PATH=src/ dotenv -e .env.development -- graphql-codegen --config src/lib/graphql/codegen.config.ts",
    "graphql:generate:watch": "bun graphql:generate -w",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "check": "biome check --diagnostic-level=error",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "lint": "biome lint --diagnostic-level=error",
    "knip": "knip-bun",
    "email:preview": "email dev --dir src/components/emails --port 3001",
    "prepare": "husky"
  },
  "dependencies": {
    "@ark-ui/react": "^5.30.0",
    "@git-diff-view/file": "^0.1.7",
    "@git-diff-view/react": "^0.1.7",
    "@omnidotdev/providers": "github:omnidotdev/providers#5b1f5ef",
    "@omnidotdev/thornberry": "github:omnidotdev/thornberry#372ebb2",
    "@radix-ui/react-slot": "^1.3.0",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.26",
    "better-auth": "~1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.12",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "graphql-sse": "^2.6.0",
    "lucide-react": "^1.21.0",
    "marked": "^18.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hotkeys-hook": "^5.3.2",
    "reactflow": "^11.11.4",
    "satori": "^0.26.0",
    "sharp": "^0.35.2",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unleash-client": "^6.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@graphql-codegen/add": "^7.0.1",
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/plugin-helpers": "^7.0.1",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-graphql-request": "^7.1.0",
    "@graphql-codegen/typescript-operations": "^6.0.4",
    "@graphql-codegen/typescript-react-query": "^7.0.5",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@react-email/preview-server": "5.2.10",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/devtools-vite": "^0.8.0",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.0",
    "@tanstack/react-devtools": "^0.10.7",
    "@tanstack/react-query-devtools": "^5.101.1",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "knip": "^6.18.0",
    "react-email": "^6.6.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "overrides": {
    "@tanstack/query-core": "5.101.1"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "esbuild",
    "sharp"
  ]
}
