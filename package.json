{
  "name": "@omnidotdev/arbor-app",
  "type": "module",
  "scripts": {
    "dev": "bun dev:vite",
    "dev:vite": "bun --env-file .env.local --env-file .env.development vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "check": "biome check --diagnostic-level=error",
    "format": "biome format --write",
    "lint": "biome lint --diagnostic-level=error",
    "knip": "knip-bun",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.141.8",
    "@tanstack/react-start": "^1.141.8",
    "clsx": "^2.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/devtools-vite": "^0.3.12",
    "@tanstack/nitro-v2-vite-plugin": "^1.141.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "husky": "^9.1.7",
    "knip": "^5.75.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-mkcert": "^1.17.9",
    "vite-tsconfig-paths": "^6.0.3"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide",
    "esbuild"
  ]
}
